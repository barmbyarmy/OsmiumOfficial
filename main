local function setRadius(px, time)
	for _, c in ipairs(corners) do tween(c, time, { CornerRadius = UDim.new(0, px) }, Quint) end
end
new("UIStroke", { Color = WHITE, Transparency = 0.88 }, card)

local GLASS_DEPTH = 0.3
local GLASS_INSET_SMALL = -22
local GLASS_INSET = -46
local GLASS_SHIFT_Y = 0
local dof = new("DepthOfFieldEffect", {
	Name = "OsmiumDOF", FarIntensity = 0, NearIntensity = 0, FocusDistance = 51.6, InFocusRadius = 50,
}, Lighting)
local glass = new("Part", {
	Name = "OsmiumGlass", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
	CastShadow = false, Material = Enum.Material.Glass, Color = BLACK, Transparency = 0.98,
	Size = Vector3.new(0.1, 0.1, 0.001),
}, camera)
RunService:BindToRenderStep("OsmiumGlass", Enum.RenderPriority.Last.Value, function()
	local pos, size = card.AbsolutePosition, card.AbsoluteSize
	local t = math.clamp((size.Y - SMALL.Y.Offset) / (FULL.Y.Offset - SMALL.Y.Offset), 0, 1)
	local inset = GLASS_INSET_SMALL + (GLASS_INSET - GLASS_INSET_SMALL) * t
	local center = pos + size / 2 + Vector2.new(0, GuiService:GetGuiInset().Y + GLASS_SHIFT_Y)
	local ray = camera:ViewportPointToRay(center.X, center.Y)
	local point = ray.Origin + ray.Direction * (GLASS_DEPTH / ray.Direction:Dot(camera.CFrame.LookVector))
	local spp = 2 * GLASS_DEPTH * math.tan(math.rad(camera.FieldOfView) / 2) / camera.ViewportSize.Y
	glass.Size = Vector3.new(math.max(size.X - inset * 2, 1) * spp, math.max(size.Y - inset * 2, 1) * spp, 0.001)
	glass.CFrame = CFrame.new(point) * camera.CFrame.Rotation
end)

local layers = {}
local function addLayer(color, peak, rot, speed, os_, ph, z)
	local f = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z }, card)
	table.insert(corners, round(f, 18))
	local g = new("UIGradient", {
		Rotation = rot,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, peak),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	table.insert(layers, { g = g, rot = rot, speed = speed, os = os_, ph = ph })
end
addLayer(Color3.fromRGB(150, 62, 108), 0.92, 0, 22, 0.55, 0, 1)
addLayer(Color3.fromRGB(170, 90, 130), 0.96, 70, -16, 0.4, 2, 2)
