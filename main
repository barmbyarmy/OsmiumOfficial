	local function openPopup(anchor, w, ph, alignRight, onClose)
		closePopup()
		local a, asz = anchor.AbsolutePosition, anchor.AbsoluteSize
		local screen = camera.ViewportSize
		local x = math.clamp(alignRight and (a.X + asz.X - w) or a.X, 8, math.max(screen.X - w - 8, 8))
		local up = a.Y + asz.Y + 4 + ph > screen.Y - 8
		local y1 = up and (a.Y - ph - 4) or (a.Y + asz.Y + 4)
		local y0 = up and (a.Y - 4) or y1
		local popup = new("Frame", {
			Position = UDim2.fromOffset(x, y0), Size = UDim2.fromOffset(w, 0), BackgroundColor3 = T.popup,
			BackgroundTransparency = 0.05, BorderSizePixel = 0, ClipsDescendants = true, Active = true, ZIndex = 1,
		}, popupGui)
		round(popup, 8)
		new("UIStroke", { Color = WHITE, Transparency = 0.88 }, popup)
		tween(popup, 0.22, { Size = UDim2.fromOffset(w, ph), Position = UDim2.fromOffset(x, y1) }, Quint)
		currentPopup = {
			close = function()
				tween(popup, 0.16, { Size = UDim2.fromOffset(w, 0), Position = UDim2.fromOffset(x, y0) }, Quint)
				task.delay(0.18, function() popup:Destroy() end)
				if onClose then onClose() end
			end,
		}
		blocker.Visible = true
		return popup
	end

