	local NOTIF_PAD = 6
	local notifItems = {}
	local notifDof = new("DepthOfFieldEffect", {
		Name = "OsmiumNotifDOF", FarIntensity = 0, NearIntensity = 0, FocusDistance = 51.6, InFocusRadius = 50,
	}, Lighting)
