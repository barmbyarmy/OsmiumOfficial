local arcGrad = new("UIGradient", {
	Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.7, 1),
		NumberSequenceKeypoint.new(0.95, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	}),
}, arcStroke)
local spinning = false

local function showMark(valid)
	local color = valid and GREEN or RED
	local TH = 2.8
	local holder = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 11,
	}, card)
	local pop = new("UIScale", { Scale = 0.8 }, holder)

	local C = Vector2.new(SMALL.X.Offset / 2, SMALL.Y.Offset / 2)
	local paths
	if valid then
		paths = {
			{ Vector2.new(-15, 1), Vector2.new(-5, 12) },
			{ Vector2.new(-5, 12), Vector2.new(17, -13) },
		}
	else
		paths = {
			{ Vector2.new(-14, -14), Vector2.new(14, 14) },
			{ Vector2.new(14, -14), Vector2.new(-14, 14) },
		}
	end

	local segs, sum = {}, 0
	for i, p in ipairs(paths) do
		local a, b = C + p[1], C + p[2]
		local f = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(TH, TH), BackgroundColor3 = color,
			BorderSizePixel = 0, Visible = false,
			Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X)),
		}, holder)
		round(f)
		new("UIStroke", { Color = color, Thickness = 0.8 }, f)
		segs[i] = { f = f, a = a, b = b, len = (b - a).Magnitude, dir = (b - a).Unit }
		sum += segs[i].len
	end

	local function draw(s, p)
		if p <= 0 then s.f.Visible = false return end
		s.f.Visible = true
		local len = s.len * p
		local center = s.a + s.dir * (len / 2)
		s.f.Position = UDim2.fromOffset(center.X, center.Y)
		s.f.Size = UDim2.fromOffset(len, TH)
	end

	tween(holder, 0.2, { GroupTransparency = 0 }, Sine)
	tween(pop, 0.45, { Scale = 1 }, Back)

	local t0, DUR = os.clock(), 0.5
	while true do
		local a = math.clamp((os.clock() - t0) / DUR, 0, 1)
		local dist = TweenService:GetValue(a, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut) * sum
		for _, s in ipairs(segs) do
			draw(s, math.clamp(dist / s.len, 0, 1))
			dist = math.max(dist - s.len, 0)
		end
		if a >= 1 then break end
		RunService.RenderStepped:Wait()
	end
	task.wait(0.2)
	return holder
end

local conn = RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for _, L in ipairs(layers) do
		L.g.Rotation = L.rot + t * L.speed
		L.g.Offset = Vector2.new(math.sin(t * L.os + L.ph) * 0.35, math.cos(t * L.os * 0.8 + L.ph) * 0.35)
	end
	caret.BackgroundTransparency = focused and (0.5 - 0.5 * math.sin(t * 5)) or 1
	if spinning then arcGrad.Rotation = (t * 420) % 360 end
end)
gui.Destroying:Connect(function()
	conn:Disconnect()
	RunService:UnbindFromRenderStep("OsmiumGlass")
	glass:Destroy()
	dof:Destroy()
end)

local busy = false

local function login()
	if _killed then return end
	if busy then return end
	local key = box.Text:gsub("%s+", "")
	if key == "" then return end
	busy = true
	box:ReleaseFocus()

	tween(content, 0.35, { GroupTransparency = 1 }, Sine)
	task.wait(0.4)
	content.Visible = false
	tween(card, 0.55, { Size = SMALL }, Quint)
	task.wait(0.5)

	spinScale.Scale = 0.5
	spinner.Visible, spinning = true, true
	tween(spinner, 0.25, { GroupTransparency = 0 }, Sine)
	tween(spinScale, 0.4, { Scale = 1 }, Back)
	local ok, valid = pcall(validateKey, key)
	valid = ok and valid
	tween(spinner, 0.2, { GroupTransparency = 1 }, Sine)
	task.wait(0.22)
	spinning, spinner.Visible = false, false

	local holder = showMark(valid)
	if not valid and lastAuthReason then
		warn("[Osmium] Auth failed: " .. tostring(lastAuthReason))
	end
	if valid then
		saveKeyToDisk(key)
		task.wait(0.3)
		tween(card, 0.4, { GroupTransparency = 1 }, Sine)
		tween(dof, 0.4, { NearIntensity = 0 }, Sine)
		task.wait(0.45)
		gui:Destroy()
		buildMain()
	else
		task.wait(0.4)
		tween(holder, 0.3, { GroupTransparency = 1 }, Sine)
		task.wait(0.32)
		holder:Destroy()
		content.Position = UDim2.new(0.5, 0, 0.5, 12)
		tween(card, 0.6, { Size = FULL }, Quint)
		task.wait(0.65)
		content.Visible = true
		tween(content, 0.55, { GroupTransparency = 0 }, Sine)
		tween(content, 0.7, { Position = UDim2.fromScale(0.5, 0.5) }, Quint)
		task.wait(0.6)
		busy = false
	end
end

btn.MouseButton1Click:Connect(login)
box.FocusLost:Connect(function(enter)
	focused = false
	tween(fieldStroke, 0.2, { Color = WHITE, Transparency = 0.85 })
	tween(keyIcon, 0.35, { Rotation = -45 }, Back)
	if enter then login() end
end)


do
	local _authkey_ref = authkey
	local _validate_ref = validateKey
	local _doRequest_ref = doRequest
	local _login_ref = login

	local function tamper(reason)
		if _killed then return end
		_killed = true
		warn("[Osmium] Protection triggered: " .. tostring(reason))
		pcall(function()
			local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				for _, g in ipairs(pg:GetChildren()) do
					if g:IsA("ScreenGui") and string.sub(g.Name, 1, 6) == "Osmium" then
						g:Destroy()
					end
				end
			end
		end)
		pcall(function()
			if typeof(script) == "Instance" then script.Disabled = true end
		end)
	end

	task.spawn(function()
		while true do
			task.wait(2)
			if _killed then return end
			if authkey ~= _authkey_ref then tamper("authkey modified") return end
			if validateKey ~= _validate_ref then tamper("validateKey hooked") return end
			if doRequest ~= _doRequest_ref then tamper("doRequest hooked") return end
			if login ~= _login_ref then tamper("login hooked") return end
			if EXPECTED_PLACE_ID > 0 and game.PlaceId ~= EXPECTED_PLACE_ID then tamper("wrong place") return end
		end
	end)
end


local storedKey = loadKeyFromDisk()

if storedKey then
	card.Size = SMALL
	content.Visible = false
	content.GroupTransparency = 1
	tween(card, 0.6, { GroupTransparency = 0 }, Quint)
	tween(dof, 0.6, { NearIntensity = 1 }, Sine)

	task.spawn(function()
		task.wait(0.3)
		busy = true

		spinScale.Scale = 0.5
		spinner.Visible, spinning = true, true
		tween(spinner, 0.25, { GroupTransparency = 0 }, Sine)
		tween(spinScale, 0.4, { Scale = 1 }, Back)

		local ok, valid = pcall(validateKey, storedKey)
		valid = ok and valid

		tween(spinner, 0.2, { GroupTransparency = 1 }, Sine)
		task.wait(0.22)
		spinning, spinner.Visible = false, false

		if valid then
			showMark(true)
			task.wait(0.5)
			tween(card, 0.4, { GroupTransparency = 1 }, Sine)
			tween(dof, 0.4, { NearIntensity = 0 }, Sine)
			task.wait(0.45)
			gui:Destroy()
			buildMain()
		else
			deleteKeyFromDisk()
			if lastAuthReason then
				warn("[Osmium] Stored key rejected: " .. tostring(lastAuthReason))
			end
			content.Position = UDim2.new(0.5, 0, 0.5, 12)
			tween(card, 0.6, { Size = FULL }, Quint)
			task.wait(0.65)
			content.Visible = true
			tween(content, 0.55, { GroupTransparency = 0 }, Sine)
			tween(content, 0.7, { Position = UDim2.fromScale(0.5, 0.5) }, Quint)
			task.wait(0.6)
			busy = false
			local msg = "Stored key is no longer valid. Enter a new one."
			for i = 1, #msg do
				subtitle.Text = msg:sub(1, i)
				task.wait(0.03)
			end
		end
	end)
else
	tween(card, 0.7, { Size = FULL, GroupTransparency = 0 })
	tween(dof, 0.7, { NearIntensity = 1 }, Sine)
	task.delay(0.35, function()
		local s = "Enter your key to continue."
		for i = 1, #s do
			subtitle.Text = s:sub(1, i)
			task.wait(0.03)
		end
	end)
end
