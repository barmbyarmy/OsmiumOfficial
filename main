	local function setNotifBlur(v)
		if notifBlurOn == v then return end
		notifBlurOn = v
		tween(notifDof, 0.3, { NearIntensity = v and 1 or 0 }, Sine)
	end

	RunService:BindToRenderStep("OsmiumNotifGlass", Enum.RenderPriority.Last.Value, function()
		local screen = camera.ViewportSize
		local inset = GuiService:GetGuiInset().Y
		local any = false
		for i = #notifItems, 1, -1 do
			local item = notifItems[i]
			if not item.t.Parent then
				item.glass:Destroy()
				table.remove(notifItems, i)
			else
				any = true
				local pos, size = item.t.AbsolutePosition, item.t.AbsoluteSize
				local gx, gy = pos.X - NOTIF_PAD, pos.Y - NOTIF_PAD
				local gw, gh = size.X + NOTIF_PAD * 2, size.Y + NOTIF_PAD * 2
				local center = Vector2.new(gx + gw / 2, gy + gh / 2 + inset)
				local ray = camera:ViewportPointToRay(center.X, center.Y)
				local point = ray.Origin + ray.Direction * (NOTIF_GLASS_DEPTH / ray.Direction:Dot(camera.CFrame.LookVector))
				local spp = 2 * NOTIF_GLASS_DEPTH * math.tan(math.rad(camera.FieldOfView) / 2) / screen.Y
				item.glass.Size = Vector3.new(math.max(gw, 1) * spp, math.max(gh, 1) * spp, 0.001)
				item.glass.CFrame = CFrame.new(point) * camera.CFrame.Rotation
			end
		end
		setNotifBlur(any and blurOn)
	end)
