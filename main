		local l = new("TextLabel", {
			Text = str, TextSize = size, TextColor3 = color, Font = font or Enum.Font.Gotham,
			TextXAlignment = align or Enum.TextXAlignment.Left, BackgroundTransparency = 1, BorderSizePixel = 0,
