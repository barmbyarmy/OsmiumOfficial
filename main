		local center = Vector2.new(gx + gw / 2, gy + gh / 2 + GuiService:GetGuiInset().Y + GLASS_SHIFT_Y)
		local ray = camera:ViewportPointToRay(center.X, center.Y)
		local point = ray.Origin + ray.Direction * (GLASS_DEPTH / ray.Direction:Dot(camera.CFrame.LookVector))
		local spp = 2 * GLASS_DEPTH * math.tan(math.rad(camera.FieldOfView) / 2) / camera.ViewportSize.Y
		glass.Size = Vector3.new(math.max(gw, 1) * spp, math.max(gh, 1) * spp, 0.001)
		glass.CFrame = CFrame.new(point) * camera.CFrame.Rotation
	end)
	mainGui.Destroying:Connect(function()
		RunService:UnbindFromRenderStep("OsmiumMenuGlass")
		glass:Destroy()
		dof:Destroy()
	end)

	new("Frame", {
		Position = UDim2.new(0, 14, 1, -64), Size = UDim2.new(1, -28, 0, 1), BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.93, BorderSizePixel = 0,
	}, sidebar)
	local avatar = new("ImageLabel", {
		Position = UDim2.new(0, 16, 1, -50), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = T.field, BorderSizePixel = 0,
	}, sidebar)
	round(avatar)
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and img then avatar.Image = img end
	end)
	text(sidebar, player.DisplayName, 13, WHITE, Enum.Font.GothamBold, nil, {
		Position = UDim2.new(0, 58, 1, -50), Size = UDim2.fromOffset(106, 16), TextTruncate = Enum.TextTruncate.AtEnd,
	})
	text(sidebar, "Licensed", 11, Color3.fromRGB(150, 62, 108), Enum.Font.GothamMedium, nil, {
		Position = UDim2.new(0, 58, 1, -33), Size = UDim2.fromOffset(106, 14),
	})

	local topbar = new("Frame", {
		Position = UDim2.fromOffset(SIDE, 0), Size = UDim2.new(1, -SIDE, 0, TOP), BackgroundTransparency = 1,
	}, window)
	new("Frame", {
		Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.94, BorderSizePixel = 0,
	}, topbar)

	local pageHolder = new("Frame", {
		Position = UDim2.fromOffset(SIDE, TOP), Size = UDim2.fromOffset(W - SIDE, H - TOP),
		BackgroundTransparency = 1, ClipsDescendants = true,
	}, window)

	local function makeDraggable(frame)
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging, dragStart, startPos = true, input.Position, window.Position
				closePopup()
			end
		end)
	end
	makeDraggable(topbar)
	makeDraggable(sidebar)

	connect(UserInputService.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				local d = input.Position - dragStart
				window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
			if activeSlider then
				local pt = pointer(input)
				activeSlider.update(pt.X, pt.Y)
			end
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if activeSlider then
				local s = activeSlider
				activeSlider = nil
				s.release()
			end
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local changed = false
			for _, b in ipairs(binds) do
				if b.mode == "Hold" and b.key and b.key == input.KeyCode and b.active then
					b.active = false
					changed = true
				end
			end
			if changed then refreshList() end
		end
	end)

	local function setShown(v)
		if shown == v then return end
		shown = v
		closePopup()
		if v then window.Visible = true end
		tween(window, 0.3, { GroupTransparency = v and 0 or 1 }, Quint)
		tween(dof, 0.3, { NearIntensity = (blurOn and v) and 1 or 0 }, Sine)
		tween(winScale, 0.35, { Scale = v and baseScale or baseScale * 0.94 }, Quint)
		if not v then
			task.delay(0.32, function() if not shown then window.Visible = false end end)
		end
	end

	connect(UserInputService.InputBegan, function(input, gp)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			local l = listening
			listening = nil
			if input.KeyCode == Enum.KeyCode.Escape then l.set(nil) else l.set(input.KeyCode) end
			return
		end
		if gp then return end
		if input.KeyCode == menuKey then
			setShown(not shown)
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local changed = false
			for _, b in ipairs(binds) do
				if b.key and b.key == input.KeyCode then
					if b.mode == "Hold" then
						b.active = true
						changed = true
					elseif b.mode == "Toggle" then
						b.active = not b.active
						changed = true
					end
				end
			end
			if changed then refreshList() end
		end
	end)

	local function buildIcon(kind, parent, color)
		local parts = {}
		local function bar(x, y, w, h, rot)
			local f = new("Frame", {
				Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = color,
				BorderSizePixel = 0, Rotation = rot or 0,
			}, parent)
			round(f)
			table.insert(parts, { f, "BackgroundColor3" })
			return f
		end
		local function arm(cx, cy, len, th, rot) return bar(cx - len / 2, cy - th / 2, len, th, rot) end
		local function sq(x, y, w, h)
			local f = new("Frame", {
				Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = color, BorderSizePixel = 0,
			}, parent)
			table.insert(parts, { f, "BackgroundColor3" })
			return f
		end
		local function outline(x, y, w, h, th, r)
			local f = new("Frame", {
				Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, BorderSizePixel = 0,
			}, parent)
			if r then round(f, r) else round(f) end
			local st = new("UIStroke", { Color = color, Thickness = th }, f)
			table.insert(parts, { st, "Color" })
			return f
		end

		if kind == "crosshair" then
			outline(4, 4, 8, 8, 2)
			sq(7, 0, 2, 4); sq(7, 12, 2, 4)
			sq(0, 7, 4, 2); sq(12, 7, 4, 2)
		elseif kind == "mouse" then
			outline(3.9, 1.9, 8.2, 12.2, 1.4, 4)
			bar(7.3, 4.4, 1.4, 3.2)
		elseif kind == "person" then
			bar(5.2, 1.4, 5.6, 5.6)
			bar(2.5, 9, 11, 9)
		elseif kind == "globe" then
			outline(1.9, 1.9, 12.2, 12.2, 1.4)
			bar(2, 7.3, 12, 1.4)
			outline(5.2, 1.9, 5.6, 12.2, 1.2)
		elseif kind == "sliders" then
			bar(1.5, 3.2, 13, 1.4); bar(1.5, 7.3, 13, 1.4); bar(1.5, 11.4, 13, 1.4)
			bar(9, 2.1, 3.6, 3.6); bar(3.4, 6.2, 3.6, 3.6); bar(8.6, 10.3, 3.6, 3.6)
		elseif kind == "code" then
			arm(4.3, 5.9, 6, 1.5, -45); arm(4.3, 10.1, 6, 1.5, 45)
			arm(11.7, 5.9, 6, 1.5, 45); arm(11.7, 10.1, 6, 1.5, -45)
			arm(8, 8, 9, 1.4, -70)
		elseif kind == "document" then
			outline(3.4, 1.9, 9.2, 12.2, 1.4, 2)
			bar(5.4, 5.2, 5.2, 1.3); bar(5.4, 8, 5.2, 1.3); bar(5.4, 10.8, 3, 1.3)
		elseif kind == "save" then
			outline(2.4, 2.4, 11.2, 11.2, 1.4, 2)
			bar(5.2, 3.6, 5.6, 2.8); bar(5.2, 9.2, 5.6, 3.4)
		elseif kind == "plus" then
			bar(7.25, 2.5, 1.5, 11); bar(2.5, 7.25, 11, 1.5)
		elseif kind == "upload" then
			bar(7.25, 3.5, 1.5, 8); bar(3, 12.5, 10, 1.5)
			arm(6.5, 4.5, 4.2, 1.5, -45); arm(9.5, 4.5, 4.2, 1.5, 45)
		elseif kind == "download" then
			bar(7.25, 2.5, 1.5, 8); bar(3, 13, 10, 1.5)
			arm(6.5, 9.5, 4.2, 1.5, 45); arm(9.5, 9.5, 4.2, 1.5, -45)
		elseif kind == "cloud" then
			bar(1.5, 8, 13, 5); bar(3.5, 5, 5.5, 5.5); bar(7, 3, 6, 6)
		elseif kind == "sort" then
			bar(2, 3.5, 12, 1.5); bar(2, 7.25, 8, 1.5); bar(2, 11, 4, 1.5)
		elseif kind == "trash" then
			bar(2, 3.5, 12, 1.5); bar(6, 1.5, 4, 1.5)
			bar(3.25, 6, 1.5, 8.5); bar(11.25, 6, 1.5, 8.5); bar(3.25, 13, 9.5, 1.5)
			bar(6, 8, 1.5, 4); bar(8.5, 8, 1.5, 4)
		elseif kind == "dots" then
			bar(2, 7, 2, 2); bar(7, 7, 2, 2); bar(12, 7, 2, 2)
		elseif kind == "search" then
			outline(2, 2, 8, 8, 1.5)
			arm(11.5, 11.5, 5, 1.5, 45)
		elseif kind == "keyboard" then
			outline(1, 3, 14, 10, 1.2, 2.5)
			for i = 0, 3 do
				sq(3.1 + i * 2.8, 5.4, 1.6, 1.6)
				sq(3.1 + i * 2.8, 7.9, 1.6, 1.6)
			end
			sq(5.1, 10.4, 6.1, 1.6)
		end
		return parts
	end

	local KL_W, KL_HEAD, KL_ROW = 230, 34, 28
	local listWanted = false
	local klist = new("CanvasGroup", {
		Name = "KeybindList", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -10, 0.5, 0),
		Size = UDim2.fromOffset(KL_W, KL_HEAD), BackgroundColor3 = PINK_BG, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, GroupTransparency = 1, Visible = false,
	}, mainGui)
	round(klist, 10)
	new("UIStroke", { Color = Color3.fromRGB(150, 62, 108), Transparency = 0.55 }, klist)

	local klHeader = new("Frame", {
		Size = UDim2.new(1, 0, 0, KL_HEAD), BackgroundColor3 = PINK_BG, BackgroundTransparency = 0,
		BorderSizePixel = 0, ZIndex = 1,
	}, klist)
	round(klHeader, 10)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(0.7, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, klHeader)

	local function applyPinkGradient(v)
		pinkGradient = v
		pinkTint.Visible = v
		klHeader.Visible = v
		klist.BackgroundColor3 = v and PINK_BG or T.popup
		for _, item in ipairs(notifItems) do
			item.t.BackgroundColor3 = v and PINK_BG or T.popup
		end
	end
	applyPinkGradient(pinkGradient)

	local klIconHolder = new("Frame", {
		Position = UDim2.fromOffset(12, 9), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, ZIndex = 2,
	}, klist)
	buildIcon("keyboard", klIconHolder, Color3.fromRGB(150, 62, 108))
	text(klist, "Keybinds", 13, WHITE, Enum.Font.GothamBold, nil, {
		Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -44, 0, KL_HEAD), ZIndex = 2,
	})
	new("Frame", {
		Position = UDim2.fromOffset(10, KL_HEAD - 1), Size = UDim2.new(1, -20, 0, 1), BackgroundColor3 = Color3.fromRGB(150, 62, 108),
		BackgroundTransparency = 0.65, BorderSizePixel = 0, ZIndex = 2,
	}, klist)
	local klRows = new("Frame", {
		Position = UDim2.fromOffset(0, KL_HEAD + 3), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, klist)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, klRows)

	local KL_GLASS_DEPTH = 0.3
	local KL_PAD_L, KL_PAD_R, KL_PAD_T, KL_PAD_B = 4, 12, 8, 8
	local klDof = new("DepthOfFieldEffect", {
		Name = "OsmiumKeybindListDOF", FarIntensity = 0, NearIntensity = 0, FocusDistance = 51.6, InFocusRadius = 50,
	}, Lighting)
	local klGlass = new("Part", {
		Name = "OsmiumKeybindListGlass", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		CastShadow = false, Material = Enum.Material.Glass, Color = BLACK, Transparency = 0.98,
		Size = Vector3.new(0.1, 0.1, 0.001),
	}, camera)
	RunService:BindToRenderStep("OsmiumKeybindListGlass", Enum.RenderPriority.Last.Value, function()
		if not klist.Visible then return end
		local pos, size = klist.AbsolutePosition, klist.AbsoluteSize
		local gx, gy = pos.X - KL_PAD_L, pos.Y - KL_PAD_T
		local gw, gh = size.X + KL_PAD_L + KL_PAD_R, size.Y + KL_PAD_T + KL_PAD_B
		local center = Vector2.new(gx + gw / 2, gy + gh / 2 + GuiService:GetGuiInset().Y)
		local ray = camera:ViewportPointToRay(center.X, center.Y)
		local point = ray.Origin + ray.Direction * (KL_GLASS_DEPTH / ray.Direction:Dot(camera.CFrame.LookVector))
		local spp = 2 * KL_GLASS_DEPTH * math.tan(math.rad(camera.FieldOfView) / 2) / camera.ViewportSize.Y
		klGlass.Size = Vector3.new(math.max(gw, 1) * spp, math.max(gh, 1) * spp, 0.001)
		klGlass.CFrame = CFrame.new(point) * camera.CFrame.Rotation
	end)
	mainGui.Destroying:Connect(function()
		RunService:UnbindFromRenderStep("OsmiumKeybindListGlass")
		klGlass:Destroy()
		klDof:Destroy()
	end)

	refreshList = function()
		local n = 0
		for i, b in ipairs(binds) do
			local listed = b.key ~= nil or b.mode == "Always"
			if listed and not b.row then
				local frame = new("Frame", {
					Size = UDim2.new(1, 0, 0, KL_ROW), BackgroundColor3 = Color3.fromRGB(150, 62, 108), BackgroundTransparency = 1, LayoutOrder = i,
				}, klRows)
				frame.MouseEnter:Connect(function() tween(frame, 0.15, { BackgroundTransparency = 0.88 }) end)
				frame.MouseLeave:Connect(function() tween(frame, 0.2, { BackgroundTransparency = 1 }) end)
				local nameLbl = text(frame, b.name, 13, T.dim, Enum.Font.GothamMedium, nil, {
					Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -124, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
				})
				local rightLbl = text(frame, "", 14, Color3.fromRGB(150, 62, 108), Enum.Font.GothamMedium, Enum.TextXAlignment.Right, {
					AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.fromOffset(106, KL_ROW),
					TextTruncate = Enum.TextTruncate.AtEnd,
				})
				b.row = { frame = frame, name = nameLbl, right = rightLbl }
			end
			if b.row then
				b.row.frame.Visible = listed
				if listed then
					n += 1
					b.row.name.Text = b.name
					b.row.right.Text = "[" .. (b.key and b.key.Name or "None") .. "] " .. b.mode
					tween(b.row.name, 0.15, { TextColor3 = b.active and WHITE or T.dim })
				end
			end
		end
		local h = KL_HEAD + (n > 0 and (n * KL_ROW + 8) or 0)
		tween(klist, 0.35, { Size = UDim2.fromOffset(KL_W, h) }, Quint)
	end

	local function setListVisible(v)
		listWanted = v
		if v then
			klist.Visible = true
			refreshList()
		end
		tween(klist, 0.35, { GroupTransparency = v and 0 or 1 }, Sine)
		tween(klDof, 0.35, { NearIntensity = (blurOn and v) and 1 or 0 }, Sine)
		tween(klist, 0.5, { Position = UDim2.new(0, v and 16 or -10, 0.5, 0) }, Quint)
		if not v then
			task.delay(0.4, function() if not listWanted then klist.Visible = false end end)
		end
	end

	local tabs, allPanels, current, switchToken = {}, {}, nil, 0
	local _pageCount = 0

	local function newPage()
		_pageCount = _pageCount + 1
		local frame = new("CanvasGroup", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false,
		}, pageHolder)
		local scroll = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = Color3.fromRGB(150, 62, 108), ScrollBarImageTransparency = 0.3, CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
		}, frame)
		local cols = new("Frame", {
			Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -32, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, scroll)
		new("UIPadding", { PaddingBottom = UDim.new(0, 18) }, cols)
		local function col(xs, xo)
			local c = new("Frame", {
				Position = UDim2.new(xs, xo, 0, 0), Size = UDim2.new(0.5, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			}, cols)
			new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, c)
			return c
		end
		return { frame = frame, left = col(0, 0), right = col(0.5, 8), id = _pageCount }
	end

	local function newPanel(page, side, title)
		local parent = side == "left" and page.left or page.right
		local frame = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.panel,
			BackgroundTransparency = 0.1, BorderSizePixel = 0,
		}, parent)
		round(frame, 10)
		new("UIStroke", { Color = WHITE, Transparency = 0.94 }, frame)
		text(frame, title, 14, WHITE, Enum.Font.GothamBold, nil, {
			Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(200, 18),
		})
		local body = new("Frame", {
			Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, frame)
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, body)
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10),
		}, body)
		local panel = { frame = frame, body = body, rows = {}, title = title:lower(), page = page }
		table.insert(allPanels, panel)
		return panel
	end

	local function selectTab(tab)
		if current == tab then return end
		closePopup()
		local old = current
		current = tab
		switchToken += 1
		local token = switchToken
		for _, t in ipairs(tabs) do
			tween(t.label, 0.25, { TextColor3 = (t == tab) and WHITE or T.dim })
			for _, pr in ipairs(t.icon) do tween(pr[1], 0.25, { [pr[2]] = (t == tab) and T.accent or T.dim }) end
		end
		tween(selector, 0.4, { Position = UDim2.fromOffset(12, tab.y) }, Quint)
		if old then
			local o = old.page.frame
			tween(o, 0.14, { GroupTransparency = 1 }, Sine)
			task.delay(0.15, function() if current ~= old then o.Visible = false end end)
		end
		local pf = tab.page.frame
		task.delay(old and 0.12 or 0, function()
			if switchToken ~= token then return end
			pf.Visible = true
			pf.Position = UDim2.fromOffset(0, 14)
			tween(pf, 0.4, { Position = UDim2.fromOffset(0, 0) }, Quint)
			tween(pf, 0.3, { GroupTransparency = 0 }, Sine)
		end)
	end

	local tabY = 70
	local function addCategory(name)
		text(sidebar, name:upper(), 10, T.dim, Enum.Font.GothamBold, nil, {
			Position = UDim2.fromOffset(24, tabY + 6), Size = UDim2.fromOffset(120, 14),
		})
		tabY += 24
	end
	local function addTab(name, iconKind)
		local y = tabY
		tabY += 38
		local btn = new("TextButton", {
			Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(SIDE - 24, 34), BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false,
		}, sidebar)
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 13, 0.5, 0), Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1, ClipsDescendants = true,
		}, btn)
		local icon = buildIcon(iconKind, holder, T.dim)
		local lbl = text(btn, name, 13, T.dim, Enum.Font.GothamMedium, nil, {
			Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -40, 1, 0),
		})
		local tab = { y = y, label = lbl, icon = icon, page = newPage() }
		table.insert(tabs, tab)
		local function tint(c) for _, pr in ipairs(icon) do tween(pr[1], 0.15, { [pr[2]] = c }) end end
		btn.MouseButton1Click:Connect(function() selectTab(tab) end)
		btn.MouseEnter:Connect(function()
			if current ~= tab then tween(lbl, 0.15, { TextColor3 = T.text }) tint(T.text) end
		end)
		btn.MouseLeave:Connect(function()
			if current ~= tab then tween(lbl, 0.15, { TextColor3 = T.dim }) tint(T.dim) end
		end)
		return tab.page
	end

	local _rowKeyCount = {}
	local function newRow(panel, h, label)
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
			LayoutOrder = #panel.rows + 1,
		}, panel.body)
		round(row, 6)
		table.insert(panel.rows, { frame = row, text = label:lower() })

		local baseKey = tostring(panel.page.id or 0) .. ":" .. panel.title .. ":" .. label:lower()
		local key = baseKey
		local n = 1
		while _rowKeyCount[key] do n = n + 1 key = baseKey .. "#" .. n end
		_rowKeyCount[key] = true
		row:SetAttribute("OsmiumCfgKey", key)

		local lbl = text(row, label, 13, T.text, Enum.Font.Gotham, nil, {
			Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.55, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
		})
		row.MouseEnter:Connect(function() tween(row, 0.15, { BackgroundTransparency = 0.95 }) end)
		row.MouseLeave:Connect(function() tween(row, 0.2, { BackgroundTransparency = 1 }) end)
		return row, lbl
	end

	local function toKey(v)
		if typeof(v) == "EnumItem" then return v end
		if type(v) == "string" then
			local ok, k = pcall(function() return Enum.KeyCode[v] end)
			if ok then return k end
		end
		return nil
	end

	local function makeKeybind(row, xOffset, name, defaultKey, withModes, cb)
		local bind = { name = name, key = toKey(defaultKey), mode = "Hold", active = false }
		if withModes then table.insert(binds, bind) end

		local rowKey = row:GetAttribute("OsmiumCfgKey")
		local bindKey = rowKey and (rowKey .. ":bind") or nil
		local function bindToData()
			local d = { key = bind.key and bind.key.Name or nil }
			if withModes then d.mode = bind.mode end
			return d
		end
		local function dataToBind(d)
			if type(d) ~= "table" then return end
			bind.key = d.key and toKey(d.key) or nil
			if withModes and d.mode then
				bind.mode = d.mode
				bind.active = (d.mode == "Always")
			end
			refreshList()
		end
		regCfg(bindKey, dataToBind)
		writeCfg(bindKey, bindToData())

		local btn = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0), Size = UDim2.fromOffset(26, 22),
			BackgroundColor3 = T.field, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, row)
		round(btn, 5)
		local stroke = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, btn)
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
		}, btn)
		local icon = buildIcon("keyboard", holder, WHITE)
		local function tint()
			for _, pr in ipairs(icon) do tween(pr[1], 0.15, { [pr[2]] = WHITE }) end
		end
		tint()
		btn.MouseEnter:Connect(function() tween(btn, 0.15, { BackgroundColor3 = Color3.fromRGB(38, 38, 46) }) end)
		btn.MouseLeave:Connect(function() tween(btn, 0.2, { BackgroundColor3 = T.field }) end)

		local function open()
			if listening then listening.cancel() listening = nil end
			local PW = 190
			local PH = withModes and 134 or 46
			local popup = openPopup(btn, PW, PH, true, function()
				if listening and listening.owner == bind then
					listening.cancel()
					listening = nil
				end
				tween(stroke, 0.2, { Color = WHITE, Transparency = 0.92 })
			end)
			currentPopup.owner = btn
			tween(stroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 })

			local keyBtn = new("TextButton", {
				Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(PW - 16, 30), BackgroundColor3 = T.field,
				BorderSizePixel = 0, Text = "", AutoButtonColor = false,
			}, popup)
			round(keyBtn, 7)
			local kst = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, keyBtn)
			local kh = new("Frame", {
				Position = UDim2.fromOffset(9, 7), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
			}, keyBtn)
			buildIcon("keyboard", kh, WHITE)
			local keyLbl = text(keyBtn, "", 12, T.text, Enum.Font.GothamMedium, nil, {
				Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -40, 1, 0),
			})
			local function showKey()
				keyLbl.Text = bind.key and bind.key.Name or "None"
				keyLbl.TextColor3 = T.text
			end
			showKey()
			keyBtn.MouseButton1Click:Connect(function()
				if listening then listening.cancel() end
				keyLbl.Text = "Press a key..."
				keyLbl.TextColor3 = Color3.fromRGB(150, 62, 108)
				tween(kst, 0.15, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 })
				listening = {
					owner = bind,
					cancel = function()
						showKey()
						tween(kst, 0.15, { Color = WHITE, Transparency = 0.92 })
					end,
					set = function(kc)
						bind.key = kc
						showKey()
						tween(kst, 0.15, { Color = WHITE, Transparency = 0.92 })
						tint()
						refreshList()
						writeCfg(bindKey, bindToData())
						if cb then cb(kc) end
					end,
				}
			end)

			if withModes then
				new("Frame", {
					Position = UDim2.fromOffset(8, 44), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.93, BorderSizePixel = 0,
				}, popup)
				local entries = {}
				local function paint()
					for m, e in pairs(entries) do
						local on = bind.mode == m
						tween(e.btn, 0.15, { BackgroundTransparency = on and 0.82 or 1 })
						tween(e.lbl, 0.15, { TextColor3 = on and WHITE or T.dim })
						for _, pr in ipairs(e.icon) do tween(pr[1], 0.15, { [pr[2]] = on and T.accent or T.dim }) end
					end
				end
				for i, m in ipairs({ "Hold", "Toggle", "Always" }) do
					local mb = new("TextButton", {
						Position = UDim2.fromOffset(8, 52 + (i - 1) * 26), Size = UDim2.new(1, -16, 0, 24),
						BackgroundColor3 = Color3.fromRGB(150, 62, 108), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
					}, popup)
					round(mb, 6)
					local ml = text(mb, m, 13, T.dim, Enum.Font.GothamMedium, nil, {
						Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -20, 1, 0),
					})
					entries[m] = { btn = mb, lbl = ml, icon = {} }
					mb.MouseButton1Click:Connect(function()
						bind.mode = m
						bind.active = (m == "Always")
						paint()
						tint()
						refreshList()
						writeCfg(bindKey, bindToData())
					end)
				end
				paint()
			end
		end
		btn.MouseButton1Click:Connect(open)
		btn.MouseButton2Click:Connect(open)

		if withModes then refreshList() end
		return bind
	end

	local function addToggle(panel, label, default, opts)
		opts = opts or {}
		local row = newRow(panel, 32, label)
		local cfgKey = row:GetAttribute("OsmiumCfgKey")
		local state = default and true or false
		local click = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, row)
		local sw = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(34, 18),
			BackgroundColor3 = state and Color3.fromRGB(150, 62, 108) or T.off, BorderSizePixel = 0,
		}, row)
		round(sw)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(state and 19 or 3, 9),
			Size = UDim2.fromOffset(12, 12), BackgroundColor3 = WHITE, BorderSizePixel = 0,
		}, sw)
		round(knob)
		local function set(v)
			state = v
			tween(sw, 0.2, { BackgroundColor3 = v and Color3.fromRGB(150, 62, 108) or T.off }, Quint)
			tween(knob, 0.25, { Position = UDim2.fromOffset(v and 19 or 3, 9) }, Quint)
			writeCfg(cfgKey, v)
			if opts.cb then opts.cb(v) end
		end
		regCfg(cfgKey, function(v) set(v == true) end)
		writeCfg(cfgKey, state)
		click.MouseButton1Click:Connect(function() set(not state) end)
		if opts.key then
			makeKeybind(row, -50, label, opts.key ~= true and opts.key or nil, true)
		end
	end

	local function addSlider(panel, label, min, max, default, opts)
		opts = opts or {}
		local step, suffix = opts.step or 1, opts.suffix or ""
		local row, lbl = newRow(panel, 44, label)
		local cfgKey = row:GetAttribute("OsmiumCfgKey")
		lbl.Position, lbl.Size = UDim2.fromOffset(8, 4), UDim2.new(0.6, 0, 0, 18)
		local valLbl = text(row, "", 12, Color3.fromRGB(150, 62, 108), Enum.Font.GothamMedium, Enum.TextXAlignment.Right, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(80, 18),
		})
		local track = new("Frame", {
			Position = UDim2.new(0, 8, 0, 29), Size = UDim2.new(1, -16, 0, 4), BackgroundColor3 = T.off, BorderSizePixel = 0,
		}, row)
		round(track)
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(150, 62, 108), BorderSizePixel = 0 }, track)
		round(fill)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = WHITE, BorderSizePixel = 0,
		}, track)
		round(knob)
		new("UIStroke", { Color = Color3.fromRGB(150, 62, 108), Thickness = 2 }, knob)
		local hit = new("TextButton", {
			Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "",
		}, row)

		local function fmt(v)
			if step < 1 then return string.format("%.1f", v) end
			return tostring(v)
		end
		local function set(v, dur, silent)
			v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
			v = math.floor(v * 100 + 0.5) / 100
			local a = (v - min) / (max - min)
			tween(fill, dur or 0.15, { Size = UDim2.fromScale(a, 1) }, Quad)
			tween(knob, dur or 0.15, { Position = UDim2.fromScale(a, 0.5) }, Quad)
			valLbl.Text = fmt(v) .. suffix
			writeCfg(cfgKey, v)
			if not silent and opts.cb then opts.cb(v) end
		end
		regCfg(cfgKey, function(v) set(v, 0.15, false) end)
		set(default, 0, true)

		local function updateFromX(x)
			local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			set(min + a * (max - min), 0.08)
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				activeSlider = {
					update = updateFromX,
					release = function() tween(knob, 0.15, { Size = UDim2.fromOffset(12, 12) }, Quad) end,
				}
				tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) }, Quad)
				updateFromX(pointer(input).X)
			end
		end)
		hit.MouseEnter:Connect(function() if not activeSlider then tween(knob, 0.15, { Size = UDim2.fromOffset(14, 14) }, Quad) end end)
		hit.MouseLeave:Connect(function() if not activeSlider then tween(knob, 0.15, { Size = UDim2.fromOffset(12, 12) }, Quad) end end)
	end

	local function makeDropdown(parent, pos, size, anchor, options, default, multi, cb)
		local cfgKey = parent:GetAttribute("OsmiumCfgKey")
		local btn = new("TextButton", {
			AnchorPoint = anchor or Vector2.zero, Position = pos, Size = size, BackgroundColor3 = T.field,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, parent)
		round(btn, 7)
		local stroke = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, btn)
		local lbl = text(btn, "", 12, T.text, Enum.Font.Gotham, nil, {
			Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local arrow = chevron(btn)

		local selected = {}
		if multi then
			for _, v in ipairs(default or {}) do selected[v] = true end
		else
			selected[default or options[1]] = true
		end
		local function display()
			if multi then
				local t = {}
				for _, o in ipairs(options) do if selected[o] then table.insert(t, o) end end
				lbl.Text = #t > 0 and table.concat(t, ", ") or "None"
			else
				for _, o in ipairs(options) do if selected[o] then lbl.Text = o end end
			end
		end
		display()

		if cfgKey then
			regCfg(cfgKey, function(v)
				if multi then
					selected = {}
					for _, o in ipairs(v or {}) do selected[o] = true end
					display()
					if cb then
						local out = {}
						for _, o in ipairs(options) do if selected[o] then table.insert(out, o) end end
						cb(out)
					end
				else
					selected = { [v] = true }
					display()
					if cb then cb(v) end
				end
			end)
			if multi then
				local init = {}
				for _, o in ipairs(options) do if selected[o] then table.insert(init, o) end end
				writeCfg(cfgKey, init)
			else
				for _, o in ipairs(options) do if selected[o] then writeCfg(cfgKey, o) break end end
			end
		end

		btn.MouseEnter:Connect(function() tween(stroke, 0.15, { Transparency = 0.8 }) end)
		btn.MouseLeave:Connect(function() if not (currentPopup and currentPopup.owner == btn) then tween(stroke, 0.2, { Transparency = 0.92 }) end end)

		btn.MouseButton1Click:Connect(function()
			local ph = math.min(#options, 6) * 26 + 8
			local popup = openPopup(btn, btn.AbsoluteSize.X, ph, false, function()
				tween(arrow, 0.2, { Rotation = 0 }, Quint)
				tween(stroke, 0.2, { Color = WHITE, Transparency = 0.92 })
			end)
			currentPopup.owner = btn
			tween(arrow, 0.2, { Rotation = 180 }, Quint)
			tween(stroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 })

			local list = new("ScrollingFrame", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
				ScrollBarImageColor3 = Color3.fromRGB(150, 62, 108), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			}, popup)
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
			new("UIPadding", {
				PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
			}, list)
			for i, o in ipairs(options) do
				local ob = new("TextButton", {
					Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
					Text = o, Font = Enum.Font.Gotham, TextSize = 12, AutoButtonColor = false, LayoutOrder = i,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextColor3 = (not multi and selected[o]) and Color3.fromRGB(150, 62, 108) or T.text,
				}, list)
				round(ob, 5)
				new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, ob)
				local ind
				if multi then
					ind = new("Frame", {
						AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(9, 9),
						BackgroundColor3 = selected[o] and Color3.fromRGB(150, 62, 108) or T.off, BorderSizePixel = 0,
					}, ob)
					round(ind, 3)
				end
				ob.MouseEnter:Connect(function() tween(ob, 0.12, { BackgroundTransparency = 0.93 }) end)
				ob.MouseLeave:Connect(function() tween(ob, 0.15, { BackgroundTransparency = 1 }) end)
				ob.MouseButton1Click:Connect(function()
					if multi then
						selected[o] = not selected[o] or nil
						tween(ind, 0.15, { BackgroundColor3 = selected[o] and Color3.fromRGB(150, 62, 108) or T.off })
						display()
						local out = {}
						for _, k in ipairs(options) do if selected[k] then table.insert(out, k) end end
						writeCfg(cfgKey, out)
						if cb then cb(out) end
					else
						selected = { [o] = true }
						display()
						writeCfg(cfgKey, o)
						if cb then cb(o) end
						closePopup()
					end
				end)
			end
		end)
		return btn
	end

	local function addDropdown(panel, label, options, default, multi, cb)
		local row = newRow(panel, 36, label)
		makeDropdown(row, UDim2.new(1, -8, 0.5, 0), UDim2.fromOffset(136, 24), Vector2.new(1, 0.5), options, default, multi, cb)
	end

	local PALETTE = {
		Color3.fromRGB(150, 62, 108), Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 160, 80), Color3.fromRGB(255, 220, 90),
		Color3.fromRGB(110, 220, 130), Color3.fromRGB(80, 210, 200), Color3.fromRGB(90, 150, 255), Color3.fromRGB(150, 110, 255),
		Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200), Color3.fromRGB(110, 110, 125), Color3.fromRGB(30, 30, 36),
	}
	local function addColor(panel, label, default, cb)
		local row = newRow(panel, 32, label)
		local cfgKey = row:GetAttribute("OsmiumCfgKey")
		local h, s, v = (default or Color3.fromRGB(150, 62, 108)):ToHSV()
		local a = 1
		local sw = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(34, 18),
			BackgroundColor3 = default or Color3.fromRGB(150, 62, 108), BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, row)
		round(sw, 5)
		new("UIStroke", { Color = WHITE, Transparency = 0.8 }, sw)
		local function apply()
			local c = Color3.fromHSV(h, s, v)
			sw.BackgroundColor3 = c
			sw.BackgroundTransparency = (1 - a) * 0.85
			writeCfg(cfgKey, { r = c.R, g = c.G, b = c.B, a = a })
			if cb then cb(c, a) end
		end
		regCfg(cfgKey, function(d)
			if type(d) ~= "table" then return end
			local c = Color3.new(d.r or 1, d.g or 1, d.b or 1)
			h, s, v = c:ToHSV()
			a = d.a or 1
			sw.BackgroundColor3 = c
			sw.BackgroundTransparency = (1 - a) * 0.85
			if cb then cb(c, a) end
		end)
		do
			local dc = default or Color3.fromRGB(150, 62, 108)
			writeCfg(cfgKey, { r = dc.R, g = dc.G, b = dc.B, a = 1 })
		end

		sw.MouseButton1Click:Connect(function()
			local popup = openPopup(sw, 196, 178, true)

			local svBox = new("Frame", {
				Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(150, 130),
				BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0,
			}, popup)
			round(svBox, 6)
			local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, svBox)
			round(white, 6)
			new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
			local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, svBox)
			round(black, 6)
			new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
			local svHandle = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundTransparency = 1, BorderSizePixel = 0,
			}, svBox)
			round(svHandle)
			new("UIStroke", { Color = WHITE, Thickness = 2 }, svHandle)

			local hue = new("Frame", {
				Position = UDim2.fromOffset(170, 10), Size = UDim2.fromOffset(16, 130), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			}, popup)
			round(hue, 6)
			local kp = {}
			for i = 0, 6 do table.insert(kp, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1))) end
			new("UIGradient", { Rotation = 90, Color = ColorSequence.new(kp) }, hue)
			local hueHandle = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(20, 6), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			}, hue)
			round(hueHandle, 3)
			new("UIStroke", { Color = BLACK, Transparency = 0.5, Thickness = 1 }, hueHandle)

			local alpha = new("Frame", {
				Position = UDim2.fromOffset(10, 150), Size = UDim2.fromOffset(176, 16), BackgroundColor3 = T.off, BorderSizePixel = 0,
			}, popup)
			round(alpha, 6)
			local alphaFill = new("Frame", {
				Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(h, s, v), BorderSizePixel = 0,
			}, alpha)
			round(alphaFill, 6)
			new("UIGradient", { Transparency = NumberSequence.new(1, 0) }, alphaFill)
			local alphaHandle = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 22), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			}, alpha)
			round(alphaHandle, 3)
			new("UIStroke", { Color = BLACK, Transparency = 0.5, Thickness = 1 }, alphaHandle)

			local function refresh()
				svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				svHandle.Position = UDim2.fromScale(s, 1 - v)
				hueHandle.Position = UDim2.fromScale(0.5, h)
				alphaFill.BackgroundColor3 = Color3.fromHSV(h, s, v)
				alphaHandle.Position = UDim2.fromScale(a, 0.5)
			end
			refresh()

			local function region(frame, onUpdate)
				local hit = new("TextButton", {
					Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5,
				}, frame)
				hit.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						activeSlider = {
							update = function(x, y)
								local rx = math.clamp((x - frame.AbsolutePosition.X) / math.max(frame.AbsoluteSize.X, 1), 0, 1)
								local ry = math.clamp((y - frame.AbsolutePosition.Y) / math.max(frame.AbsoluteSize.Y, 1), 0, 1)
								onUpdate(rx, ry)
								apply()
								refresh()
							end,
							release = function() end,
						}
						local pt = pointer(input)
						activeSlider.update(pt.X, pt.Y)
					end
				end)
			end
			region(svBox, function(rx, ry) s = rx v = 1 - ry end)
			region(hue, function(_, ry) h = math.min(ry, 0.999) end)
			region(alpha, function(rx) a = rx end)
		end)
	end

	local function addButton(panel, label, cb)
		local row, lbl = newRow(panel, 36, label)
		lbl.Visible = false
		local b = new("TextButton", {
			Position = UDim2.fromOffset(4, 3), Size = UDim2.new(1, -8, 1, -6), BackgroundColor3 = T.field, BorderSizePixel = 0,
			Text = label, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text, AutoButtonColor = false,
		}, row)
		round(b, 7)
		local st = new("UIStroke", { Color = WHITE, Transparency = 0.93 }, b)
		b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = Color3.fromRGB(36, 36, 44) }) tween(st, 0.15, { Transparency = 0.85 }) end)
		b.MouseLeave:Connect(function() tween(b, 0.2, { BackgroundColor3 = T.field }) tween(st, 0.2, { Transparency = 0.93 }) end)
		b.MouseButton1Click:Connect(function()
			b.BackgroundColor3 = Color3.fromRGB(150, 62, 108)
			tween(b, 0.35, { BackgroundColor3 = Color3.fromRGB(36, 36, 44) }, Quint)
			if cb then cb() end
		end)
	end

	local function addInput(panel, label, placeholder, cb)
		local row = newRow(panel, 36, label)
		local tb = new("TextBox", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(136, 24),
			BackgroundColor3 = T.field, BorderSizePixel = 0, Text = "", PlaceholderText = placeholder or "",
			PlaceholderColor3 = T.dim, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
		round(tb, 7)
		new("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }, tb)
		local st = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, tb)
		tb.Focused:Connect(function() tween(st, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 }) end)
		tb.FocusLost:Connect(function(enter)
			tween(st, 0.2, { Color = WHITE, Transparency = 0.92 })
			if cb then cb(tb.Text, enter) end
		end)
		return tb
	end

	local function addKeybind(panel, label, defaultName, cb)
		local row = newRow(panel, 32, label)
		makeKeybind(row, -8, label, defaultName, false, cb)
	end

	local saveBtn = new("TextButton", {
		Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(96, 32), BackgroundColor3 = T.field,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	}, topbar)
	round(saveBtn, 8)
	local saveStroke = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, saveBtn)
	local saveIcon = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
	}, saveBtn)
	buildIcon("save", saveIcon, T.accent)
	text(saveBtn, "Save", 13, T.text, Enum.Font.GothamMedium, nil, {
		Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -62, 1, 0),
	})
	local saveArrow = chevron(saveBtn)
	saveBtn.MouseEnter:Connect(function() tween(saveBtn, 0.15, { BackgroundColor3 = Color3.fromRGB(38, 38, 46) }) end)
	saveBtn.MouseLeave:Connect(function() tween(saveBtn, 0.2, { BackgroundColor3 = T.field }) end)

	local function iconButton(parent, kind, size, pos, anchor, cb)
		local b = new("TextButton", {
			AnchorPoint = anchor or Vector2.zero, Position = pos, Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, parent)
		round(b, 6)
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
		}, b)
		local icon = buildIcon(kind, holder, T.dim)
		local function tint(c) for _, pr in ipairs(icon) do tween(pr[1], 0.15, { [pr[2]] = c }) end end
		b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundTransparency = 0.93 }) tint(T.text) end)
		b.MouseLeave:Connect(function() tween(b, 0.2, { BackgroundTransparency = 1 }) tint(T.dim) end)
		b.MouseButton1Click:Connect(function() if cb then cb() end end)
		return b
	end


	local presets = listConfigsOnDisk()
	local activePreset = presets[1]
	local sortAsc = true

	local function loadPresetAndApply(name)
		local data = loadConfigFromDisk(name)
		if not data then return false end
		applyConfigData(data)
		return true
	end

	local function openRowMenu(anchor, onLoad, onOverwrite, onRename, onDelete)
		if menuClose then menuClose() end
		local MW, MH = 140, 132
		local a, asz, screen = anchor.AbsolutePosition, anchor.AbsoluteSize, camera.ViewportSize
		local x = math.clamp(a.X + asz.X - MW, 8, math.max(screen.X - MW - 8, 8))
		local down = a.Y + asz.Y + 4 + MH <= screen.Y - 8
		local y1 = down and (a.Y + asz.Y + 4) or (a.Y - MH - 4)
		local y0 = down and y1 or (a.Y - 4)

		local blk = new("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2,
		}, popupGui)
		local menu = new("Frame", {
			Position = UDim2.fromOffset(x, y0), Size = UDim2.fromOffset(MW, 0), BackgroundColor3 = T.popup,
			BackgroundTransparency = 0.04, BorderSizePixel = 0, ClipsDescendants = true, Active = true, ZIndex = 3,
		}, popupGui)
		round(menu, 8)
		new("UIStroke", { Color = WHITE, Transparency = 0.88 }, menu)
		tween(menu, 0.18, { Size = UDim2.fromOffset(MW, MH), Position = UDim2.fromOffset(x, y1) }, Quint)

		local closed = false
		local function close()
			if closed then return end
			closed = true
			if menuClose == close then menuClose = nil end
			blk:Destroy()
			tween(menu, 0.14, { Size = UDim2.fromOffset(MW, 0), Position = UDim2.fromOffset(x, y0) }, Quint)
			task.delay(0.16, function() menu:Destroy() end)
		end
		menuClose = close
		blk.MouseButton1Click:Connect(close)

		local function item(y, label, kind, color, hover, cb)
			local b = new("TextButton", {
				Position = UDim2.fromOffset(4, y), Size = UDim2.new(1, -8, 0, 28), BackgroundColor3 = hover,
				BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
			}, menu)
			round(b, 6)
			local h = new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(16, 16),
				BackgroundTransparency = 1,
			}, b)
			buildIcon(kind, h, color)
			text(b, label, 13, color, Enum.Font.GothamMedium, nil, {
				Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -36, 1, 0),
			})
			b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundTransparency = 0.9 }) end)
			b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundTransparency = 1 }) end)
			b.MouseButton1Click:Connect(function()
				close()
				cb()
			end)
		end
		item(4,   "Load",      "download", T.text, WHITE, onLoad)
		item(36,  "Overwrite", "save",     T.text, WHITE, onOverwrite)
		item(68,  "Rename",    "document", T.text, WHITE, onRename)
		item(100, "Delete",    "trash",    RED,    RED,   onDelete)
	end

	local function openPresets()
		local PW, PH = 252, 222
		local popup = openPopup(saveBtn, PW, PH, false, function()
			tween(saveArrow, 0.2, { Rotation = 0 }, Quint)
			tween(saveStroke, 0.2, { Color = WHITE, Transparency = 0.92 })
		end)
		currentPopup.owner = saveBtn
		tween(saveArrow, 0.2, { Rotation = 180 }, Quint)
		tween(saveStroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 })

		local head = new("Frame", {
			Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(PW - 16, 28), BackgroundTransparency = 1,
		}, popup)
		local chip = new("Frame", {
			Size = UDim2.fromOffset(88, 28), BackgroundColor3 = Color3.fromRGB(150, 62, 108), BackgroundTransparency = 0.8, BorderSizePixel = 0,
		}, head)
		round(chip, 7)
		local cloudHolder = new("Frame", {
			Position = UDim2.fromOffset(9, 6), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		}, chip)
		buildIcon("cloud", cloudHolder, T.accent)
		text(chip, "Presets", 13, T.accent, Enum.Font.GothamMedium, nil, {
			Position = UDim2.fromOffset(31, 0), Size = UDim2.new(1, -34, 1, 0),
		})

		local sb = new("Frame", {
			Position = UDim2.fromOffset(8, 44), Size = UDim2.fromOffset(PW - 16, 30), BackgroundColor3 = T.field, BorderSizePixel = 0,
		}, popup)
		round(sb, 7)
		local sbStroke = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, sb)
		local magHolder = new("Frame", {
			Position = UDim2.fromOffset(9, 7), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		}, sb)
		buildIcon("search", magHolder, T.dim)
		local box = new("TextBox", {
			Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -68, 1, 0), BackgroundTransparency = 1, Text = "",
			PlaceholderText = "Search", PlaceholderColor3 = T.dim, TextColor3 = T.text, Font = Enum.Font.Gotham,
			TextSize = 12, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
		}, sb)
		box.Focused:Connect(function() tween(sbStroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 }) end)
		box.FocusLost:Connect(function() tween(sbStroke, 0.2, { Color = WHITE, Transparency = 0.92 }) end)

		local list = new("ScrollingFrame", {
			Position = UDim2.fromOffset(8, 82), Size = UDim2.fromOffset(PW - 16, PH - 90), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(150, 62, 108), CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, popup)
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		new("UIPadding", {
			PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 1), PaddingLeft = UDim.new(0, 1), PaddingRight = UDim.new(0, 1),
		}, list)


		local function openRenameDialog(oldName, onDone)
			local RW, RH = 250, 122
			local screen = camera.ViewportSize
			local x = math.floor((screen.X - RW) / 2)
			local y = math.floor((screen.Y - RH) / 2)

			local blk = new("TextButton", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 4,
			}, popupGui)

			local dialog = new("Frame", {
				Position = UDim2.fromOffset(x, y + 8), Size = UDim2.fromOffset(RW, 0),
				BackgroundColor3 = T.popup, BackgroundTransparency = 0.04, BorderSizePixel = 0,
				ClipsDescendants = true, Active = true, ZIndex = 5,
			}, popupGui)
			round(dialog, 10)
			new("UIStroke", { Color = WHITE, Transparency = 0.88 }, dialog)
			tween(dialog, 0.22, { Size = UDim2.fromOffset(RW, RH), Position = UDim2.fromOffset(x, y) }, Quint)

			local closed = false
			local function close()
				if closed then return end
				closed = true
				blk:Destroy()
				tween(dialog, 0.16, { Size = UDim2.fromOffset(RW, 0), Position = UDim2.fromOffset(x, y + 8) }, Quint)
				task.delay(0.18, function() dialog:Destroy() end)
			end
			blk.MouseButton1Click:Connect(close)

			text(dialog, "Rename preset", 14, T.text, Enum.Font.GothamBold, nil, {
				Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 18),
			})

			local tb = new("TextBox", {
				Position = UDim2.fromOffset(14, 40), Size = UDim2.new(1, -28, 0, 30),
				BackgroundColor3 = T.field, BorderSizePixel = 0, Text = oldName or "",
				PlaceholderText = "New name", PlaceholderColor3 = T.dim, TextColor3 = T.text,
				Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = false,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, dialog)
			round(tb, 7)
			new("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }, tb)
			local tst = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, tb)
			tb.Focused:Connect(function() tween(tst, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 }) end)
			tb.FocusLost:Connect(function() tween(tst, 0.2, { Color = WHITE, Transparency = 0.92 }) end)

			local cancelBtn = new("TextButton", {
				Position = UDim2.fromOffset(RW - 152, 78), Size = UDim2.fromOffset(66, 32),
				BackgroundColor3 = T.field, BorderSizePixel = 0, Text = "",
				Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text, AutoButtonColor = false,
			}, dialog)
			round(cancelBtn, 7)
			new("UIStroke", { Color = WHITE, Transparency = 0.92 }, cancelBtn)
			text(cancelBtn, "Cancel", 13, T.text, Enum.Font.GothamMedium, Enum.TextXAlignment.Center, {
				Size = UDim2.fromScale(1, 1),
			})
			cancelBtn.MouseEnter:Connect(function() tween(cancelBtn, 0.15, { BackgroundColor3 = Color3.fromRGB(36, 36, 44) }) end)
			cancelBtn.MouseLeave:Connect(function() tween(cancelBtn, 0.2, { BackgroundColor3 = T.field }) end)
			cancelBtn.MouseButton1Click:Connect(function()
				close()
				if onDone then onDone(false) end
			end)

			local okBtn = new("TextButton", {
				Position = UDim2.fromOffset(RW - 80, 78), Size = UDim2.fromOffset(66, 32),
				BackgroundColor3 = Color3.fromRGB(150, 62, 108), BorderSizePixel = 0, Text = "",
				Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = WHITE, AutoButtonColor = false,
			}, dialog)
			round(okBtn, 7)
			text(okBtn, "Rename", 13, WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Center, {
				Size = UDim2.fromScale(1, 1),
			})
			okBtn.MouseEnter:Connect(function() tween(okBtn, 0.15, { BackgroundColor3 = Color3.fromRGB(170, 70, 120) }) end)
			okBtn.MouseLeave:Connect(function() tween(okBtn, 0.2, { BackgroundColor3 = Color3.fromRGB(150, 62, 108) }) end)
			local function confirm()
				local newName = tb.Text:match("^%s*(.-)%s*$")
				if newName == "" or newName == oldName then
					close()
					if onDone then onDone(false) end
					return
				end
				local exists = false
				for _, v in ipairs(presets) do
					if v:lower() == newName:lower() then exists = true break end
				end
				if exists then
					notify("That name is already taken")
					return
				end
				close()
				if onDone then onDone(true, newName) end
			end
			okBtn.MouseButton1Click:Connect(confirm)
			tb.FocusLost:Connect(function(enter) if enter then confirm() end end)
			task.defer(function() tb:CaptureFocus() end)
		end

		local function render()
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			local q = box.Text:lower()
			local names = {}
			for _, n in ipairs(presets) do
				if q == "" or n:lower():find(q, 1, true) then table.insert(names, n) end
			end
			table.sort(names, function(a, b)
				if sortAsc then return a:lower() < b:lower() end
				return a:lower() > b:lower()
			end)
			for i, n in ipairs(names) do
				local on = n == activePreset
				local row = new("Frame", {
					Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(150, 62, 108), BackgroundTransparency = on and 0.85 or 1,
					BorderSizePixel = 0, LayoutOrder = i,
				}, list)
				round(row, 7)
				if on then new("UIStroke", { Color = Color3.fromRGB(150, 62, 108), Transparency = 0.45 }, row) end
				text(row, n, 13, on and WHITE or T.text, Enum.Font.GothamMedium, nil, {
					Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -66, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
				})
				local dotsBtn
				dotsBtn = iconButton(row, "dots", 24, UDim2.new(1, -32, 0.5, 0), Vector2.new(1, 0.5), function()
					openRowMenu(dotsBtn,
						function() 
							if loadPresetAndApply(n) then
								activePreset = n
								notify("Loaded preset: " .. n)
								render()
							else
								notify("No config found: " .. n)
							end
						end,
						function() 
							saveConfigToDisk(n, ConfigData)
							notify("Overwrote preset: " .. n)
						end,
						function() 
							openRenameDialog(n, function(ok, newName)
								if not ok then return end
								if renameConfigOnDisk(n, newName) then
									for k, v in ipairs(presets) do
										if v == n then presets[k] = newName break end
									end
									if activePreset == n then activePreset = newName end
									notify("Renamed preset: " .. n .. " → " .. newName)
									render()
								else
									notify("Could not rename: " .. n)
								end
							end)
						end,
						function() 
							deleteConfigFromDisk(n)
							for k, v in ipairs(presets) do
								if v == n then table.remove(presets, k) break end
							end
							if activePreset == n then activePreset = presets[1] end
							notify("Deleted preset: " .. n)
							render()
						end
					)
				end)
				iconButton(row, on and "save" or "download", 24, UDim2.new(1, -4, 0.5, 0), Vector2.new(1, 0.5), function()
					if on then
						saveConfigToDisk(n, ConfigData)
						notify("Saved preset: " .. n)
					else
						if loadPresetAndApply(n) then
							activePreset = n
							notify("Loaded preset: " .. n)
							render()
						else
							notify("No config found: " .. n)
						end
					end
				end)
			end
		end

		iconButton(head, "plus", 28, UDim2.new(1, 0, 0, 0), Vector2.new(1, 0), function()
			local name = box.Text:match("^%s*(.-)%s*$")
			if name == "" then name = "Preset " .. (#presets + 1) end
			for _, v in ipairs(presets) do
				if v:lower() == name:lower() then notify("That preset already exists") return end
			end
			saveConfigToDisk(name, ConfigData)
			table.insert(presets, name)
			activePreset = name
			box.Text = ""
			notify("Created preset: " .. name)
			render()
		end)
		iconButton(head, "save", 28, UDim2.new(1, -30, 0, 0), Vector2.new(1, 0), function()
			if activePreset then
				saveConfigToDisk(activePreset, ConfigData)
				notify("Saved preset: " .. activePreset)
			else
				notify("No preset selected")
			end
		end)
		iconButton(head, "upload", 28, UDim2.new(1, -60, 0, 0), Vector2.new(1, 0), function()
			notify("Imported from clipboard (demo)")
		end)

		iconButton(sb, "sort", 26, UDim2.new(1, -3, 0.5, 0), Vector2.new(1, 0.5), function()
			sortAsc = not sortAsc
			render()
		end)

		box:GetPropertyChangedSignal("Text"):Connect(render)
		render()
	end
	saveBtn.MouseButton1Click:Connect(openPresets)

	local searchBox = new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), Size = UDim2.fromOffset(190, 32),
		BackgroundColor3 = T.field, BorderSizePixel = 0,
	}, topbar)
	round(searchBox, 8)
	local searchStroke = new("UIStroke", { Color = WHITE, Transparency = 0.92 }, searchBox)
	local ring = new("Frame", {
		Position = UDim2.fromOffset(11, 10), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1,
	}, searchBox)
	round(ring)
	new("UIStroke", { Color = T.dim, Thickness = 1.5 }, ring)
	local handle = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(22, 22), Size = UDim2.fromOffset(6, 2),
		Rotation = 45, BackgroundColor3 = T.dim, BorderSizePixel = 0,
	}, searchBox)
	round(handle)
	local search = new("TextBox", {
		Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1, Text = "",
		PlaceholderText = "Search options", PlaceholderColor3 = T.dim, TextColor3 = T.text, Font = Enum.Font.Gotham,
		TextSize = 12, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
	}, searchBox)
	search.Focused:Connect(function() tween(searchStroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 }) end)
	search.FocusLost:Connect(function() tween(searchStroke, 0.2, { Color = WHITE, Transparency = 0.92 }) end)

	local function applySearch(q)
		q = (q or ""):lower():match("^%s*(.-)%s*$")
		local counts = {}
		for _, panel in ipairs(allPanels) do
			local any = false
			local titleHit = q ~= "" and panel.title:find(q, 1, true) ~= nil
			for _, r in ipairs(panel.rows) do
				local m = q == "" or titleHit or r.text:find(q, 1, true) ~= nil
				r.frame.Visible = m
				if m then any = true end
			end
			panel.frame.Visible = any
			if any then counts[panel.page] = true end
		end
		if q ~= "" and current and not counts[current.page] then
			for _, t in ipairs(tabs) do
				if counts[t.page] then selectTab(t) break end
			end
		end
	end
	search:GetPropertyChangedSignal("Text"):Connect(function() applySearch(search.Text) end)

	addCategory("Main")
	local page1 = addTab("Page 1", "crosshair")
	local page2 = addTab("Page 2", "mouse")
	addCategory("More")
	local page3 = addTab("Page 3", "person")
	local page4 = addTab("Page 4", "globe")
	addCategory("Other")
	local settings = addTab("Settings", "sliders")

	do
		local p = newPanel(page1, "left", "Section 1")
		addToggle(p, "Checkbox", true, { key = "E" })
		addToggle(p, "Checkbox 2", true)
		addToggle(p, "Checkbox 3", false)
		addSlider(p, "Slider", 1, 180, 90, { suffix = "°" })
