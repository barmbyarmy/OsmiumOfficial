local BASE_DIR      = "osmium"
local CONFIGS_PATH  = BASE_DIR .. "/configs"
local KEY_PATH      = BASE_DIR .. "/key.txt"
local CRYPT_SEED    = "osm1um_p3rs1st_2024"

local HAS_FS = type(writefile) == "function"
	and type(readfile) == "function"
	and type(isfile) == "function"


local function crypt(text)
	local out, sl = {}, #CRYPT_SEED
	for i = 1, #text do
		local b = string.byte(text, i)
		local k = string.byte(CRYPT_SEED, (i - 1) % sl + 1)
		out[i] = string.format("%02x", bit32.bxor(b, k))
	end
	return table.concat(out)
end

local function decrypt(hex)
	if type(hex) ~= "string" or #hex % 2 ~= 0 then return nil end
	local out, sl, idx = {}, #CRYPT_SEED, 0
	for i = 1, #hex, 2 do
		idx = idx + 1
		local b = tonumber(hex:sub(i, i + 1), 16)
		if not b then return nil end
		local k = string.byte(CRYPT_SEED, (idx - 1) % sl + 1)
		out[idx] = string.char(bit32.bxor(b, k))
	end
	return table.concat(out)
end

local function splitPath(path)
	local parts = {}
	for seg in string.gmatch(path, "[^/\\]+") do
		table.insert(parts, seg)
	end
	return parts
end


local FS = {}

if HAS_FS then
	local function ensureFolder(path)
		if type(isfolder) == "function" then
			if not isfolder(path) and type(makefolder) == "function" then
				pcall(makefolder, path)
			end
		end
	end
	ensureFolder(BASE_DIR)
	ensureFolder(CONFIGS_PATH)

	function FS.write(path, data)
		local ok = pcall(writefile, path, data)
		return ok
	end
	function FS.read(path)
		if type(isfile) ~= "function" or not isfile(path) then return nil end
		local ok, data = pcall(readfile, path)
		return (ok and type(data) == "string") and data or nil
	end
	function FS.exists(path)
		return type(isfile) == "function" and isfile(path)
	end
	function FS.delete(path)
		if type(delfile) == "function" and FS.exists(path) then
			pcall(delfile, path)
		end
	end
	function FS.list(dir)
		if type(listfiles) ~= "function" then return {} end
		local ok, files = pcall(listfiles, dir)
		if not ok or type(files) ~= "table" then return {} end
		return files
	end
else

	local function ensureInstanceFolder(parent, name)
		local f = parent:FindFirstChild(name)
		if not f or not f:IsA("Folder") then
			if f then f:Destroy() end
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local function resolveDir(dir, create)
		local parts = splitPath(dir)
		local cur = workspace
		for _, p in ipairs(parts) do
			local nxt = cur:FindFirstChild(p)
			if not nxt or not nxt:IsA("Folder") then
				if not create then return nil end
				nxt = ensureInstanceFolder(cur, p)
			end
			cur = nxt
		end
		return cur
	end
	function FS.write(path, data)
		local parts = splitPath(path)
		if #parts == 0 then return false end
		local dir = table.concat(parts, "/", 1, #parts - 1)
		local cur = (#parts == 1) and workspace or resolveDir(dir, true)
		if not cur then return false end
		local name = parts[#parts]
		local sv = cur:FindFirstChild(name)
		if sv and not sv:IsA("StringValue") then sv:Destroy() sv = nil end
		if not sv then
			sv = Instance.new("StringValue")
			sv.Name = name
			sv.Parent = cur
		end
		sv.Value = data
		return true
	end
	function FS.read(path)
		local parts = splitPath(path)
		if #parts == 0 then return nil end
		local dir = table.concat(parts, "/", 1, #parts - 1)
		local cur = (#parts == 1) and workspace or resolveDir(dir, false)
		if not cur then return nil end
		local f = cur:FindFirstChild(parts[#parts])
		if not f or f.Value == "" then return nil end
		return f.Value
	end
	function FS.exists(path)
		local parts = splitPath(path)
		if #parts == 0 then return false end
		local dir = table.concat(parts, "/", 1, #parts - 1)
		local cur = (#parts == 1) and workspace or resolveDir(dir, false)
		if not cur then return false end
		return cur:FindFirstChild(parts[#parts]) ~= nil
	end
	function FS.delete(path)
		local parts = splitPath(path)
		if #parts == 0 then return end
		local dir = table.concat(parts, "/", 1, #parts - 1)
		local cur = (#parts == 1) and workspace or resolveDir(dir, false)
		if not cur then return end
		local f = cur:FindFirstChild(parts[#parts])
		if f then f:Destroy() end
	end
	function FS.list(dir)
		local cur = resolveDir(dir, false)
		if not cur then return {} end
		local out = {}
		for _, c in ipairs(cur:GetChildren()) do
			if c:IsA("StringValue") then table.insert(out, dir .. "/" .. c.Name) end
		end
		return out
	end
end


local function saveKeyToDisk(key)
	FS.write(KEY_PATH, crypt(key))
end

local function loadKeyFromDisk()
	local enc = FS.read(KEY_PATH)
	if not enc or enc == "" then return nil end
	return decrypt(enc)
end

local function deleteKeyFromDisk()
	FS.delete(KEY_PATH)
end


local function saveConfigToDisk(name, data)
	local ok, json = pcall(function() return HttpService:JSONEncode(data or {}) end)
	if not ok then return end
	FS.write(CONFIGS_PATH .. "/" .. name .. ".json", crypt(json))
end

local function loadConfigFromDisk(name)
	local enc = FS.read(CONFIGS_PATH .. "/" .. name .. ".json")
	if not enc then return nil end
	local dec = decrypt(enc)
	if not dec then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(dec) end)
	return ok and data or nil
end

local function deleteConfigFromDisk(name)
	FS.delete(CONFIGS_PATH .. "/" .. name .. ".json")
end

local function renameConfigOnDisk(oldName, newName)
	local data = loadConfigFromDisk(oldName)
	if not data then return false end
	saveConfigToDisk(newName, data)
	deleteConfigFromDisk(oldName)
	return true
end

local function listConfigsOnDisk()
	local names = {}
	for _, path in ipairs(FS.list(CONFIGS_PATH)) do
		local filename = path:match("([^/\\]+)$") or path
		if filename:sub(-5) == ".json" then
			table.insert(names, filename:sub(1, -6))
		end
	end
	table.sort(names)
	return names
end


local ConfigData    = {}
local ConfigSetters = {}
local function regCfg(key, setter)
	if key and key ~= "" then ConfigSetters[key] = setter end
end
local function writeCfg(key, value)
	if key and key ~= "" then ConfigData[key] = value end
end
local function applyConfigData(data)
	if type(data) ~= "table" then return end
	for k, v in pairs(data) do
		local setter = ConfigSetters[k]
		if setter then pcall(setter, v) end
	end
end


local function getHWID()
	if syn and syn.get_hwid then
		local ok, v = pcall(syn.get_hwid); if ok and v and v ~= "" then return v end
	end
	if krnl_gethwid then
		local ok, v = pcall(krnl_gethwid); if ok and v and v ~= "" then return v end
	end
	if gethwid then
		local ok, v = pcall(gethwid); if ok and v and v ~= "" then return v end
	end
	local plr = Players.LocalPlayer
	if plr then return "user:" .. tostring(plr.UserId) end
	return "UNKNOWN_HWID"
end

local function doRequest(url, body)
	if syn and syn.request then
		local ok, r = pcall(syn.request, {
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = body,
		})
		if ok and r then return r.Status or r.StatusCode, r.Body end
		return nil, "syn.request failed: " .. tostring(r)
	end
	if request then
		local ok, r = pcall(request, {
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = body,
		})
		if ok and r then return r.Status or r.StatusCode, r.Body end
		return nil, "request() failed: " .. tostring(r)
	end
	if http_request then
		local ok, r = pcall(http_request, {
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = body,
		})
		if ok and r then return r.StatusCode or r.Status, r.Body end
		return nil, "http_request failed: " .. tostring(r)
	end
	local ok, r = pcall(function()
		return HttpService:RequestAsync({
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" }, Body = body,
		})
	end)
	if ok and r then return r.StatusCode, r.Body end
	return nil, "HttpService.RequestAsync failed: " .. tostring(r)
end

local function validateKey(key)
	if _killed then return false end
	lastAuthReason = nil
	local hwid = getHWID()
	local player = Players.LocalPlayer

	local payload = {
		key = key,
		hwid = hwid,
		user_id = player and player.UserId or 0,
		user_name = player and player.Name or "",
		display_name = player and player.DisplayName or "",
	}

	local status, body = doRequest(authkey, HttpService:JSONEncode(payload))

	if not status then
		lastAuthReason = "network_error"
		warn("[Osmium] Request failed: " .. tostring(body))
		return false
	end

	if status ~= 200 then
		lastAuthReason = "http_" .. tostring(status)
		warn("[Osmium] Server returned HTTP " .. tostring(status) .. ": " .. tostring(body):sub(1, 200))
		return false
	end

	local decodeOk, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not decodeOk or type(data) ~= "table" then
		lastAuthReason = "bad_response"
		warn("[Osmium] Server response was not valid JSON: " .. tostring(body):sub(1, 200))
		return false
	end

	lastAuthReason = data.reason
	return data.valid == true
end


local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Quint, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function round(obj, r)
	return new("UICorner", { CornerRadius = UDim.new(r and 0 or 1, r or 0) }, obj)
end

local camera = workspace.CurrentCamera

