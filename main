local TEXT_X, MAX_W = 46, 256
local maxChars = 40
local charW = math.min(TextService:GetTextSize("0", 16, Enum.Font.Code, Vector2.new(1000, 1000)).X, MAX_W / maxChars)

local typed = new("Frame", {
	Position = UDim2.fromOffset(TEXT_X, 0), Size = UDim2.fromOffset(MAX_W, 46),
	BackgroundTransparency = 1, ClipsDescendants = true,
}, field)
local placeholder = new("TextLabel", {
	Text = "License key", Font = Enum.Font.Gotham, TextSize = 15, TextColor3 = WHITE,
	TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
}, typed)
local caret = new("Frame", {
	Position = UDim2.fromOffset(1, 14), Size = UDim2.fromOffset(2, 18),
	BackgroundColor3 = Color3.fromRGB(150, 62, 108), BackgroundTransparency = 1, BorderSizePixel = 0,
}, typed)
round(caret)

local box = new("TextBox", {
	Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", PlaceholderText = "",
	TextTransparency = 1, ClearTextOnFocus = false, ZIndex = 5,
}, field)

local chars, prev = {}, ""
local function makeChar(i, ch, animate)
	local x = (i - 1) * charW
	local l = new("TextLabel", {
		Text = MASK_KEY and "•" or ch, Font = Enum.Font.Code, TextSize = MASK_KEY and 22 or 16,
		TextColor3 = WHITE, BackgroundTransparency = 1, Size = UDim2.fromOffset(charW, 46),
		Position = UDim2.fromOffset(x, animate and 9 or 0), TextTransparency = animate and 1 or 0,
	}, typed)
	if animate then tween(l, 0.22, { Position = UDim2.fromOffset(x, 0), TextTransparency = 0 }) end
	return l
end

local function sync()
	local text = box.Text
	if #text > maxChars then box.Text = text:sub(1, maxChars) return end
	if #text > #prev and text:sub(1, #prev) == prev then
		for i = #prev + 1, #text do chars[i] = makeChar(i, text:sub(i, i), true) end
	elseif #text < #prev and prev:sub(1, #text) == text then
		for i = #text + 1, #prev do
			local l = chars[i]
			chars[i] = nil
			tween(l, 0.15, { TextTransparency = 1, Position = UDim2.fromOffset((i - 1) * charW, -9) })
			task.delay(0.16, function() l:Destroy() end)
		end
	else
		for _, l in pairs(chars) do l:Destroy() end
		chars = {}
		for i = 1, #text do chars[i] = makeChar(i, text:sub(i, i), false) end
	end
	prev = text
	tween(caret, 0.09, { Position = UDim2.fromOffset(#text * charW + 1, 14) })
	tween(placeholder, 0.2, { TextTransparency = #text > 0 and 1 or 0 })
end
box:GetPropertyChangedSignal("Text"):Connect(sync)

local focused = false
box.Focused:Connect(function()
	focused = true
	tween(fieldStroke, 0.2, { Color = Color3.fromRGB(150, 62, 108), Transparency = 0 })
	tween(keyIcon, 0.35, { Rotation = -30 }, Back)
end)

